diff --git a/drivers/pci.c b/drivers/pci.c
index 6880edc..c354dc6 100644
--- a/drivers/pci.c
+++ b/drivers/pci.c
@@ -1077,6 +1077,15 @@ static void ati_radeon_setup(const pci_config_t *config, phandle_t ph)
            (int)w, (int)h, (int)bpp, (unsigned long)mmio);
 
     set_property(ph, "device_type", "display", 8);
+
+    /* retail Radeon Mac Edition ROM properties */
+    set_int_property(ph, "ATY,Flags", 0x1c4);
+    set_int_property(ph, "ATY,RefCLK", 27000);   /* kHz */
+    set_int_property(ph, "ATY,MCLK", 183000);
+    set_int_property(ph, "ATY,SCLK", 183000);
+    set_int_property(ph, "VRAM,totalsize", 0x04000000);
+    set_property(ph, "display-type", "CRT", 4);
+    set_property(ph, "character-set", "ISO8859-1", 10);
 }
 #endif
 
